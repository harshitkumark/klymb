# APNs Push Notification Configuration
# Copy this to .env.local and fill in real values.
# NEVER commit .env.local — it's in .gitignore.
#
# See: https://developer.apple.com/documentation/usernotifications

# Apple Push Key ID (10-character identifier from Apple Developer portal)
APNS_KEY_ID=YOUR_KEY_ID

# Apple Developer Team ID
APNS_TEAM_ID=YOUR_TEAM_ID

# APNs private key (ES256 / P8 format)
# Paste the full PEM content, or use a file reference in production.
# Example: -----BEGIN PRIVATE KEY-----\nMIGH...==\n-----END PRIVATE KEY-----
APNS_PRIVATE_KEY=YOUR_PRIVATE_KEY_PEM

# App bundle identifier
APNS_BUNDLE_ID=com.klymb.app

# APNs environment: "sandbox" for development, "production" for release
APNS_ENVIRONMENT=sandbox
